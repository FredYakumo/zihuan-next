    {
      "id": "search_messages",
      "name": "Search Messages",
      "description": "在消息记录中搜索，支持发送者、群组、内容关键词、时间范围过滤",
      "node_type": "message_rdb_search",
      "input_ports": [
        {
          "name": "mysql_ref",
          "data_type": "RdbRef",
          "description": "MySQL连接配置引用",
          "required": true,
          "hidden": false
        },
        {
          "name": "sender_id",
          "data_type": "String",
          "description": "可选：按发送者ID过滤",
          "required": false,
          "hidden": false
        },
        {
          "name": "group_id",
          "data_type": "String",
          "description": "可选：按群ID过滤",
          "required": false,
          "hidden": false
        },
        {
          "name": "contain",
          "data_type": "String",
          "description": "可选：消息内容包含的关键词（模糊匹配）",
          "required": false,
          "hidden": false
        },
        {
          "name": "start_time",
          "data_type": "String",
          "description": "可选：时间范围起始（YYYY-MM-DD HH:MM:SS）",
          "required": false,
          "hidden": false
        },
        {
          "name": "end_time",
          "data_type": "String",
          "description": "可选：时间范围结束（YYYY-MM-DD HH:MM:SS）",
          "required": false,
          "hidden": false
        },
        {
          "name": "limit",
          "data_type": "Integer",
          "description": "返回消息数量",
          "required": true,
          "hidden": false
        },
        {
          "name": "sort_by_time_desc",
          "data_type": "Boolean",
          "description": "是否按发送时间从新到旧排序，默认true",
          "required": true,
          "hidden": false
        }
      ],
      "output_ports": [
        {
          "name": "messages",
          "data_type": {
            "Vec": "String"
          },
          "description": "格式化后的搜索结果消息列表",
          "required": true,
          "hidden": false
        }
      ],
      "dynamic_input_ports": false,
      "dynamic_output_ports": false,
      "position": {
        "x": 900,
        "y": 180
      },
      "size": {
        "width": 300,
        "height": 260
      },
