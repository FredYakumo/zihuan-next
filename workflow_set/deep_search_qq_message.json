  "metadata": {
    "name": "QQ 消息深度搜索",
    "description": "在本群/好友的历史聊天记录与图片库中检索：按关键词搜索聊天消息，并按语义搜索历史图片，返回命中的消息列表与图片结果。需要查找过去的聊天记录或之前分享过的图片时调用。",
    "version": "2.0.0"
  },
